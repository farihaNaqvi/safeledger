# Copy to infra/.env (git-ignored) and fill in. docker compose reads it automatically.

# Shared by bank-mcp-server and agent-service to sign and verify the identity header.
# At least 32 characters. Generate one with:  openssl rand -base64 48
IDENTITY_HMAC_SECRET=

# Optional: local Postgres password (defaults to "safeledger" for local development).
# POSTGRES_PASSWORD=

# Bedrock. AWS credentials come from the shell (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN).
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Local alternative without AWS (no guardrails).
# SAFELEDGER_CHAT_MODEL=ollama
# BEDROCK_GUARDRAIL_ENABLED=false
# OLLAMA_MODEL=qwen2.5:7b
