# Copy to infra/.env (git-ignored) and fill in. docker compose reads it automatically.

# Required. Signs the identity header between agent-service and bank-mcp-server.
# At least 32 characters:  openssl rand -base64 48
IDENTITY_HMAC_SECRET=

# Optional: local Postgres password (default "safeledger").
# POSTGRES_PASSWORD=

# ---- Pick ONE model option ----

# A. Claude API (simplest). Guardrails need AWS, so they are off here.
# SAFELEDGER_CHAT_MODEL=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# BEDROCK_GUARDRAIL_ENABLED=false

# B. Amazon Bedrock with Bedrock Guardrails (the intended setup; see infra/bedrock/).
#    AWS credentials come from the shell: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN.
#    With option A, set BEDROCK_GUARDRAIL_ENABLED=true and these to keep the guardrail.
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
# AWS_REGION=us-east-1
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# C. Free and local with Ollama (https://ollama.com, then: ollama pull qwen2.5:7b). No guardrails.
#    Small local models are slow on a CPU and weaker at tool use.
# SAFELEDGER_CHAT_MODEL=ollama
# OLLAMA_MODEL=qwen2.5:7b
# BEDROCK_GUARDRAIL_ENABLED=false
# SAFELEDGER_AGENT_TURNTIMEOUT=600s

# Model prices in USD per million tokens, for the cost metrics (defaults: Claude Haiku 5.5).
# MODEL_PRICE_INPUT=0.10
# MODEL_PRICE_OUTPUT=0.50
